# Quill configuration. Copy to .env and edit. NEVER commit .env (X-04).
# All keys are prefixed QUILL_.

# --- identity ----------------------------------------------------------
QUILL_OPERATOR_HANDLE=barryallendgx
QUILL_OPERATOR_TIMEZONE=Asia/Kolkata

# --- engine ------------------------------------------------------------
# fixture = offline demo/tests (no session/GPU/network, T-01)
# playwright = real logged-in Chromium (log in via the browser service VNC)
QUILL_BROWSER_ENGINE=fixture

# --- models (OpenAI-compatible base URL; never hardcode a provider, A-03) --
QUILL_LLM_BASE_URL=http://localhost:11434/v1
QUILL_LLM_API_KEY=ollama
QUILL_DRAFT_MODEL=qwen3:30b-a3b
QUILL_CRITIC_MODEL=qwen3:32b
QUILL_EMBED_MODEL=nomic-embed-text
# set true once a model endpoint is reachable; false uses the offline fallback
QUILL_LLM_AVAILABLE=false

# --- security (§22) ----------------------------------------------------
# loopback only; reach the dashboard through a tunnel (Tailscale/Cloudflare) — X-01
QUILL_BIND_HOST=127.0.0.1
QUILL_BIND_PORT=8000
# CHANGE THESE. secret_key signs sessions; passphrase derives the at-rest key.
QUILL_SECRET_KEY=change-me-to-a-long-random-string
QUILL_OPERATOR_PASSPHRASE=change-me-operator-passphrase
QUILL_LOGIN_PASSWORD=change-me-login-password
# per-install shared secret the Chrome extension uses over localhost (A-X1)
QUILL_EXTENSION_SHARED_SECRET=change-me-extension-secret

# --- notifications (§16) — optional but strongly recommended -----------
QUILL_NTFY_BASE_URL=https://ntfy.sh
QUILL_NTFY_TOPIC=
QUILL_TELEGRAM_BOT_TOKEN=
QUILL_TELEGRAM_CHAT_ID=
QUILL_PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- browser debug surface (loopback only, X-03) -----------------------
QUILL_VNC_URL=http://127.0.0.1:6080/vnc.html
